PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/laptop_store_syp_shop
JWT_SECRET=change-this-to-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Seeded on first `npm run seed` — the store owner (super admin) account
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password

# SMTP (used for payment approval/rejection emails and abandoned cart reminders)
# Leave blank to disable email sending — in-app socket notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Laptop Store <no-reply@example.com>"
